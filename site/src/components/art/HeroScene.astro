---
// SPDX-License-Identifier: AGPL-3.0-or-later
// HeroScene — the solarpunk hillside: trees, reef hint, sun, and signal
// vines rising into a cloud made of leaves. Inline so theme vars apply.
---

<svg
  viewBox="0 0 720 400"
  class="h-auto w-full"
  role="img"
  aria-labelledby="hero-scene-t"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="hero-scene-t">A sunny hillside of trees and sea, with signals rising into a leaf-shaped cloud</title>
  <defs>
    <linearGradient id="hs-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" style="stop-color:var(--lc-sky);stop-opacity:.28"></stop>
      <stop offset="100%" style="stop-color:var(--lc-sky);stop-opacity:0"></stop>
    </linearGradient>
  </defs>

  <!-- sky -->
  <rect x="0" y="0" width="720" height="400" fill="url(#hs-sky)"></rect>

  <!-- sun -->
  <g class="lc-sway" style="transform-origin:600px 78px">
    <circle cx="600" cy="78" r="38" class="fill-sun"></circle>
    {
      Array.from({ length: 8 }).map((_, i) => {
        const a = (i * Math.PI) / 4;
        const x1 = 600 + Math.cos(a) * 48;
        const y1 = 78 + Math.sin(a) * 48;
        const x2 = 600 + Math.cos(a) * 60;
        const y2 = 78 + Math.sin(a) * 60;
        return <line x1={x1} y1={y1} x2={x2} y2={y2} class="stroke-sun" stroke-width="5" stroke-linecap="round" />;
      })
    }
  </g>

  <!-- the leaf-cloud the signals rise into -->
  <g>
    <path
      d="M240 96c-6-30 16-58 48-56 6-24 34-36 56-24 18-16 48-12 60 8 26-4 46 16 44 38 16 8 18 30 6 42-24 18-190 18-214-8-4-8-4-14 0-20z"
      class="fill-surface"
      style="stroke:var(--lc-leaf-bright);stroke-width:3;stroke-linejoin:round"></path>
    <path
      d="M300 76c16-18 60-26 88-14M330 92c20-10 44-12 62-6"
      fill="none"
      style="stroke:var(--lc-leaf-bright);stroke-width:2.4;stroke-linecap:round;opacity:.7"></path>
    <circle cx="352" cy="60" r="5" class="fill-leaf-bright"></circle>
    <circle cx="330" cy="50" r="3.4" class="fill-sun"></circle>
    <circle cx="378" cy="50" r="3.4" class="fill-sun"></circle>
  </g>

  <!-- signal vines rising from the land/sea into the cloud -->
  <g fill="none" stroke-linecap="round">
    <path
      d="M168 330C200 260 250 200 300 130"
      class="lc-dash"
      style="stroke:var(--lc-leaf-bright);stroke-width:3;stroke-dasharray:2 10"></path>
    <path
      d="M420 330C410 260 380 200 360 130"
      class="lc-dash"
      style="stroke:var(--lc-leaf-bright);stroke-width:3;stroke-dasharray:2 10;animation-delay:-1s"></path>
    <path
      d="M560 300C500 250 440 190 392 128"
      class="lc-dash"
      style="stroke:var(--lc-sky);stroke-width:3;stroke-dasharray:2 10;animation-delay:-2s"></path>
  </g>

  <!-- hills -->
  <path d="M0 320Q140 250 320 300T720 290V400H0Z" class="fill-leaf" style="opacity:.28"></path>
  <path d="M0 350Q180 290 380 330T720 320V400H0Z" class="fill-leaf" style="opacity:.55"></path>

  <!-- sea strip, right side -->
  <path d="M560 330q60-14 160-4v74H560Z" class="fill-lc-sky" style="opacity:.5"></path>
  <path d="M580 348h100M600 368h90" class="stroke-lc-sky" stroke-width="3" stroke-linecap="round" style="opacity:.7"
  ></path>
  <!-- coral hint -->
  <g class="fill-clay" style="opacity:.85">
    <circle cx="612" cy="384" r="7"></circle>
    <circle cx="626" cy="378" r="5"></circle>
    <circle cx="642" cy="386" r="6"></circle>
  </g>

  <!-- trees -->
  <g class="lc-sway" style="transform-origin:120px 340px">
    <rect x="116" y="296" width="8" height="46" rx="4" class="fill-clay"></rect>
    <circle cx="120" cy="282" r="34" class="fill-leaf"></circle>
    <circle cx="96" cy="300" r="20" class="fill-leaf"></circle>
    <circle cx="146" cy="300" r="20" class="fill-leaf"></circle>
  </g>
  <g class="lc-sway" style="transform-origin:216px 350px;animation-delay:-2.5s">
    <rect x="212" y="312" width="7" height="40" rx="3.5" class="fill-clay"></rect>
    <circle cx="215" cy="300" r="26" class="fill-leaf"></circle>
  </g>
  <g class="lc-sway" style="transform-origin:60px 360px;animation-delay:-4s">
    <rect x="57" y="330" width="6" height="34" rx="3" class="fill-clay"></rect>
    <circle cx="60" cy="320" r="22" class="fill-leaf"></circle>
  </g>

  <!-- the little listener box, sitting near (not on) the trees -->
  <g>
    <rect
      x="252"
      y="330"
      width="30"
      height="20"
      rx="5"
      class="fill-surface"
      style="stroke:var(--lc-leaf);stroke-width:2.5"></rect>
    <circle cx="262" cy="340" r="3.4" class="fill-leaf-bright"></circle>
    <path
      d="M292 332a10 10 0 0 1 0 12M297 328a16 16 0 0 1 0 20"
      fill="none"
      style="stroke:var(--lc-leaf);stroke-width:2.4;stroke-linecap:round"></path>
  </g>

  <!-- grass dots -->
  {
    [40, 90, 170, 260, 330, 470, 520].map((x) => (
      <circle cx={x} cy={368 + (x % 3) * 6} r="3.2" class="fill-leaf-bright" style="opacity:.7" />
    ))
  }
</svg>
