---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Small "how real is this?" pointer into /science anchors.
interface Props {
  anchor: string;
  label?: string;
}
const { anchor, label = 'how real is this?' } = Astro.props;
---

<a
  href={`/science#${anchor}`}
  class="mt-3 inline-flex items-center gap-1 font-mono text-xs text-[#00d992]/80 hover:text-[#00d992]"
>
  → {label}
</a>
