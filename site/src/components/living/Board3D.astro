---
// SPDX-License-Identifier: AGPL-3.0-or-later
// EcoCell One — procedural 3D model built from the real KiCad carrier layout
// (hardware/pcb/ecocell-carrier.kicad_pcb, 100x80 mm, real footprint positions).
---

<div class="board3d not-prose">
  <canvas
    id="board3d"
    class="w-full h-[340px] md:h-[420px] rounded-lg border border-line bg-surface-2 cursor-grab active:cursor-grabbing touch-none"
    aria-label="3D model of the EcoCell One field node carrier board"></canvas>
  <p class="b3cap text-muted mt-2 font-mono text-xs">
    <b class="text-heading">ecocell one</b> — carrier 100×80&nbsp;mm · ESP32-S3 · swappable sensor heads · drag to orbit
  </p>
</div>

<script>
  import * as THREE from 'three';

  const cv = document.getElementById('board3d') as HTMLCanvasElement;
  const cap = (cv.parentElement as HTMLElement).querySelector('.b3cap') as HTMLElement;
  try {
    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(38, 1, 1, 2000);
    cam.position.set(72, 80, 92);
    const ren = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true });
    ren.setPixelRatio(Math.min(devicePixelRatio, 2));

    scene.add(new THREE.AmbientLight(0xffffff, 0.55));
    const key = new THREE.DirectionalLight(0xffffff, 1.6);
    key.position.set(60, 140, 80);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x3dbe6a, 1.1);
    rim.position.set(-80, 40, -90);
    scene.add(rim);

    const matPCB = new THREE.MeshStandardMaterial({ color: 0x0a100d, roughness: 0.55, metalness: 0.25 });
    const matBlack = new THREE.MeshStandardMaterial({ color: 0x141416, roughness: 0.7 });
    const matGold = new THREE.MeshStandardMaterial({ color: 0xc9a227, roughness: 0.3, metalness: 0.9 });
    const matChip = new THREE.MeshStandardMaterial({ color: 0x1b1b1e, roughness: 0.4, metalness: 0.5 });
    const matMetal = new THREE.MeshStandardMaterial({ color: 0x9aa0a6, roughness: 0.35, metalness: 0.85 });
    const matGreen = new THREE.MeshStandardMaterial({ color: 0x0d4a32, roughness: 0.6 });
    const matBrass = new THREE.MeshStandardMaterial({ color: 0xa8853c, roughness: 0.3, metalness: 0.9 });
    const matBatt = new THREE.MeshStandardMaterial({ color: 0x12181c, roughness: 0.5, metalness: 0.3 });
    const matLED = new THREE.MeshStandardMaterial({ color: 0x3dbe6a, emissive: 0x3dbe6a, emissiveIntensity: 1.6 });

    const board = new THREE.Group();
    scene.add(board);
    const P = (x: number, y: number): [number, number] => [x - 50, y - 40];
    const add = (mesh: THREE.Object3D, x: number, y: number, z = 0, ry = 0) => {
      const [px, pz] = P(x, y);
      mesh.position.set(px, z, pz);
      mesh.rotation.y = ry;
      board.add(mesh);
      return mesh;
    };
    const box = (w: number, h: number, d: number, m: THREE.Material) =>
      new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
    const cyl = (r: number, h: number, m: THREE.Material, seg = 20) =>
      new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, seg), m);

    const SH = 3.2;
    const shape = new THREE.Shape();
    shape.moveTo(-50 + SH, -40);
    shape.lineTo(50 - SH, -40);
    shape.absarc(50 - SH, -40 + SH, SH, -Math.PI / 2, 0);
    shape.lineTo(50, 40 - SH);
    shape.absarc(50 - SH, 40 - SH, SH, 0, Math.PI / 2);
    shape.lineTo(-50 + SH, 40);
    shape.absarc(-50 + SH, 40 - SH, SH, Math.PI / 2, Math.PI);
    shape.lineTo(-50, -40 + SH);
    shape.absarc(-50 + SH, -40 + SH, SH, Math.PI, 1.5 * Math.PI);
    for (const [hx, hy] of [
      [5, 5],
      [95, 5],
      [5, 75],
      [95, 75],
    ]) {
      const h = new THREE.Path();
      h.absarc(hx - 50, hy - 40, 1.7, 0, Math.PI * 2, true);
      shape.holes.push(h);
    }
    const pcb = new THREE.Mesh(new THREE.ExtrudeGeometry(shape, { depth: 1.6, bevelEnabled: false }), matPCB);
    pcb.rotation.x = -Math.PI / 2;
    pcb.position.y = -1.6;
    board.add(pcb);

    const tc = document.createElement('canvas');
    tc.width = 1000;
    tc.height = 800;
    const g = tc.getContext('2d') as CanvasRenderingContext2D;
    g.fillStyle = '#0a100d';
    g.fillRect(0, 0, 1000, 800);
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    g.strokeStyle = 'rgba(61,190,106,.22)';
    g.lineWidth = 1.6;
    for (let i = 0; i < 150; i++) {
      let x = rnd() * 1000,
        y = rnd() * 800;
      g.beginPath();
      g.moveTo(x, y);
      for (let s = 0; s < 3 + rnd() * 3; s++) {
        if (rnd() < 0.5) x += (rnd() - 0.5) * 300;
        else y += (rnd() - 0.5) * 240;
        g.lineTo(x, y);
      }
      g.stroke();
    }
    g.fillStyle = '#c9a227';
    for (const [fx, fy] of [
      [10, 10],
      [90, 10],
      [10, 66],
    ]) {
      g.beginPath();
      g.arc(fx * 10, fy * 10, 5, 0, 7);
      g.fill();
    }
    g.lineWidth = 3;
    g.strokeStyle = '#c9a227';
    for (const [hx, hy] of [
      [5, 5],
      [95, 5],
      [5, 75],
      [95, 75],
    ]) {
      g.beginPath();
      g.arc(hx * 10, hy * 10, 20, 0, 7);
      g.stroke();
    }
    g.fillStyle = '#b8b3b0';
    g.font = '700 26px JetBrains Mono, monospace';
    g.fillText('ECOCELL ONE', 20, 790);
    g.font = '400 18px JetBrains Mono, monospace';
    g.fillText('treetable · living resources', 620, 790);
    g.fillText('5V-IN protected', 575, 760);
    g.font = '400 13px JetBrains Mono, monospace';
    g.fillStyle = '#8b949e';
    g.fillText('J1 sonic', 14, 195);
    g.fillText('J2 air', 14, 295);
    g.fillText('J3 c4d', 14, 395);
    g.fillText('J4 head-a', 782, 245);
    g.fillText('J5 head-b', 782, 375);
    g.fillText('J6 head-c', 782, 505);
    const tex = new THREE.CanvasTexture(tc);
    tex.anisotropy = 4;
    const top = new THREE.Mesh(
      new THREE.PlaneGeometry(100, 80),
      new THREE.MeshStandardMaterial({ map: tex, roughness: 0.5, metalness: 0.2, transparent: true, opacity: 0.98 })
    );
    top.rotation.x = -Math.PI / 2;
    top.position.y = 0.02;
    board.add(top);

    const esp = new THREE.Group();
    esp.add(box(21, 1, 17.8, new THREE.MeshStandardMaterial({ color: 0x14101d, roughness: 0.6 })));
    const shield = box(13, 1.6, 11, matMetal);
    shield.position.set(0, 1.3, -2);
    esp.add(shield);
    const camMod = box(9, 1.2, 9, matChip);
    camMod.position.set(0, 1.1, 5.5);
    esp.add(camMod);
    const lens = cyl(2.6, 2.4, matBlack);
    lens.position.set(0, 2.8, 5.5);
    esp.add(lens);
    const lensG = cyl(1.4, 0.6, new THREE.MeshStandardMaterial({ color: 0x0a2a1e, roughness: 0.1, metalness: 0.8 }));
    lensG.position.set(0, 4.1, 5.5);
    esp.add(lensG);
    esp.position.set(48.89 - 50, 4.6, 20 - 40);
    board.add(esp);
    for (const sx of [40, 57.78]) {
      const s = box(2.5, 3, 17.8, matBlack);
      add(s, sx, 20, 2.3);
    }
    const castl = box(21, 0.4, 17.8, matGold);
    castl.position.y = -0.9;
    esp.add(castl);

    const hdr = (x: number, y: number, n: number, rot = 0) => {
      const w = rot ? n * 2.54 : 2.54,
        d = rot ? 2.54 : n * 2.54;
      add(box(w, 2.6, d, matBlack), x, y, 2.1);
      for (let i = 0; i < n; i++) {
        const px = rot ? x - (n - 1) * 1.27 + i * 2.54 : x,
          py = rot ? y : y - (n - 1) * 1.27 + i * 2.54;
        add(box(0.9, 4.6, 0.9, matGold), px, py, 3.2);
      }
    };
    hdr(10, 20, 3);
    hdr(10, 30, 3);
    hdr(10, 40, 3);
    hdr(90, 25, 4);
    hdr(90, 38, 4);
    hdr(90, 51, 4);
    hdr(40, 64, 4);
    hdr(15, 70, 5, 1);
    hdr(46, 75, 2);
    hdr(64, 68, 2);

    const tb = box(10, 8, 8, matGreen);
    add(tb, 80, 74.5, 4.8);
    for (const dz of [-2.5, 2.5]) {
      const h = cyl(1.6, 0.4, matBlack);
      add(h, 80, 74.5 + dz, 8.9);
    }
    add(box(3.2, 1.1, 1.6, matChip), 74, 74.5, 1.4);
    for (const [x, y] of [
      [59, 74.5],
      [68, 76],
      [56, 52],
    ])
      add(box(2.8, 1.1, 1.4, matChip), x, y, 1.35);
    for (const y of [22.5, 32.5, 42.5]) add(box(1.8, 0.9, 1.2, matChip), 15.5, y, 1.25);
    add(box(1.8, 1.2, 1.8, matChip), 50, 52, 1.4);
    for (const [x, y] of [
      [42, 52],
      [71.5, 20],
      [63, 28],
    ])
      add(box(2, 1, 1.2, matChip), x, y, 1.3);
    add(box(2, 1, 1.2, matLED), 76, 20, 1.3);
    const ledGlow = new THREE.PointLight(0x3dbe6a, 6, 22);
    ledGlow.position.set(26, 6, -20);
    board.add(ledGlow);

    const sma = cyl(3.2, 6, matBrass, 6);
    sma.rotation.z = Math.PI / 2;
    add(sma, 98, 52, 3.2);
    const whip = cyl(0.8, 42, matBlack, 8);
    whip.position.set(50, 26, 12);
    whip.rotation.x = 0.12;
    board.add(whip);
    const whipTip = cyl(1.1, 5, matBlack, 8);
    whipTip.position.set(50, 46, 9);
    whipTip.rotation.x = 0.12;
    board.add(whipTip);

    const batt = box(34, 8, 48, matBatt);
    add(batt, 40, 45, -7.5);
    const jst = box(6, 5, 5, new THREE.MeshStandardMaterial({ color: 0xd8d4ce, roughness: 0.5 }));
    add(jst, 46, 75, 3.4);
    const leadM = new THREE.MeshStandardMaterial({ color: 0x8b1d1d, roughness: 0.6 });
    const lead = cyl(0.6, 14, leadM, 6);
    lead.position.set(44.2 - 50, -3, 75 - 40);
    lead.rotation.z = 0.3;
    board.add(lead);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ry = -0.55,
      rx = 0.32,
      dragging = false,
      lx = 0,
      ly = 0;
    const vy = reduce ? 0 : 0.0028;
    cv.addEventListener('pointerdown', (e) => {
      dragging = true;
      lx = e.clientX;
      ly = e.clientY;
      cv.setPointerCapture(e.pointerId);
    });
    cv.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      ry += (e.clientX - lx) * 0.008;
      rx += (e.clientY - ly) * 0.008;
      rx = Math.max(-0.1, Math.min(1.2, rx));
      lx = e.clientX;
      ly = e.clientY;
    });
    cv.addEventListener('pointerup', () => (dragging = false));
    cv.addEventListener('pointercancel', () => (dragging = false));

    const fit = () => {
      const w = cv.clientWidth,
        h = cv.clientHeight;
      ren.setSize(w, h, false);
      cam.aspect = w / h;
      cam.updateProjectionMatrix();
    };
    new ResizeObserver(fit).observe(cv);
    fit();
    cam.lookAt(0, 0, 0);

    const tick = () => {
      if (!dragging) ry += vy;
      board.rotation.y += (ry - board.rotation.y) * 0.12;
      board.rotation.x += (rx - board.rotation.x) * 0.12;
      ren.render(scene, cam);
      if (!reduce || dragging) requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        fit();
        ren.render(scene, cam);
        requestAnimationFrame(tick);
        io.disconnect();
      }
    });
    io.observe(cv);
  } catch {
    cv.style.display = 'none';
    cap.innerHTML =
      'ecocell one — 3D unavailable · <a href="https://github.com/treetable/living-resources/tree/main/hardware/pcb" class="underline text-leaf">see the KiCad sources</a>';
  }
</script>
