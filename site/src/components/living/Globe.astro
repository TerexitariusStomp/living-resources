---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Federation globe — cobe (MIT). Markers are places the living cloud could
// listen (illustrative). "Send a signal" fires a real POST /verdict per substrate.
---

<div class="globe-wrap not-prose">
  <div class="relative mx-auto max-w-[420px]">
    <canvas
      id="globe"
      class="aspect-square w-full"
      aria-label="Rotating globe showing example places the living cloud could listen"></canvas>
    <p class="text-muted mt-1 text-center font-mono text-xs">
      big dots — where our listeners could go. small dots — allied networks already listening.
    </p>
  </div>
  <div class="mt-6 text-center">
    <button
      id="firesignal"
      class="rounded-full bg-leaf px-6 py-3 font-semibold text-on-leaf transition hover:bg-leaf-bright disabled:opacity-50"
    >
      Send one signal to all fifteen wirings
    </button>
    <p id="globe-cap" class="text-muted mt-3 font-mono text-xs">a real call to the live API — not a mockup</p>
  </div>
  <div id="globe-chips" class="mt-4 hidden grid-cols-1 gap-2 font-mono text-xs sm:grid-cols-2 md:grid-cols-3"></div>
</div>

<script>
  import createGlobe from 'cobe';

  const cv = document.getElementById('globe') as HTMLCanvasElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let phi = 0;
  let raf = 0;
  let globe: { update: (o: Record<string, unknown>) => void; destroy: () => void } | null = null;

  // cobe has no runtime recolor — rebuild on theme change.
  const initGlobe = () => {
    const isDark = document.documentElement.classList.contains('dark');
    globe?.destroy();
    if (raf) cancelAnimationFrame(raf);
    try {
      globe = createGlobe(cv, {
        devicePixelRatio: 2,
        width: 420 * 2,
        height: 420 * 2,
        phi: 0,
        theta: 0.25,
        dark: isDark ? 1 : 0,
        diffuse: 1.2,
        mapSamples: 16000,
        mapBrightness: isDark ? 11 : 7,
        mapBaseBrightness: isDark ? 0.12 : 0.25,
        baseColor: isDark ? [0.06, 0.08, 0.07] : [0.93, 0.88, 0.78],
        markerColor: isDark ? [0, 0.85, 0.57] : [0.12, 0.54, 0.3],
        glowColor: isDark ? [0, 0.5, 0.36] : [0.55, 0.75, 0.6],
        markers: [
          // larger — places our own listeners could go
          { location: [-3.4, -62.2], size: 0.07 }, // amazon
          { location: [-1.8, 130.5], size: 0.07 }, // coral triangle
          { location: [60.1, -105.0], size: 0.07 }, // boreal taiga
          { location: [15.0, -1.0], size: 0.07 }, // sahel
          { location: [39.7, -104.9], size: 0.05 }, // a city park
          // smaller — allied networks listening today (federated lane)
          { location: [50.8, 4.3], size: 0.035 }, // birdweather station, europe
          { location: [47.6, -122.3], size: 0.035 }, // orcasound hydrophones
          { location: [30.0, -40.0], size: 0.035 }, // argo float, atlantic
          { location: [42.5, -72.2], size: 0.035 }, // neon site, harvard forest
          { location: [-33.9, 151.2], size: 0.035 }, // sensor.community, sydney
          { location: [35.7, 139.7], size: 0.035 }, // raspberry shake, tokyo
        ],
      });
      if (!reduce) {
        const tick = () => {
          phi += 0.003;
          globe?.update({ phi });
          raf = requestAnimationFrame(tick);
        };
        raf = requestAnimationFrame(tick);
      }
      const fit = () => {
        const w = cv.offsetWidth;
        cv.style.width = w + 'px';
        cv.style.height = w + 'px';
      };
      fit();
      addEventListener('resize', fit);
    } catch {
      (cv.parentElement as HTMLElement).innerHTML =
        '<p class="text-muted text-center font-mono text-xs">globe unavailable — WebGL needed</p>';
    }
  };
  initGlobe();
  document.addEventListener('aw:theme-change', initGlobe);

  const btn = document.getElementById('firesignal') as HTMLButtonElement;
  const chips = document.getElementById('globe-chips') as HTMLElement;
  const cap = document.getElementById('globe-cap') as HTMLElement;
  btn.addEventListener('click', async () => {
    btn.disabled = true;
    cap.textContent = 'firing one encoded signal at all fifteen substrates…';
    chips.classList.remove('hidden');
    chips.classList.add('grid');
    try {
      const FEATS = { confidence: 0.72, event_rate: 0.35, env_anomaly: 0.18, fleet_agreement: 0.81 };
      const { connectomes } = await (await fetch('/connectomes')).json();
      // Fan out per substrate — each call is a separate worker invocation,
      // so the free-plan CPU budget applies per brain, not to all fifteen.
      const rs = await Promise.allSettled(
        (connectomes as { name: string }[]).map((c) =>
          fetch('/verdict', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ connectome: c.name, features: FEATS }),
          }).then(async (r) => {
            const j = await r.json();
            if (j.verdict) return { name: c.name, verdict: j.verdict };
            return { name: c.name, error: true };
          })
        )
      );
      const ACT: Record<string, string> = { '1': 'affirm', '-1': 'refute', '0': 'abstain' };
      let answered = 0;
      chips.innerHTML = rs
        .map((r) => {
          const v = r.status === 'fulfilled' ? r.value : null;
          if (v && 'verdict' in v) {
            answered++;
            return `
        <div class="rounded border border-line bg-surface-2 px-3 py-2">
          <b class="text-heading">${v.verdict.connectome}</b>
          <span class="text-leaf"> · ${ACT[v.verdict.action] ?? v.verdict.action}</span>
          <span class="text-muted block truncate">${(v.verdict.spike_digest || '').slice(8, 34)}…</span>
        </div>`;
          }
          return `
        <div class="rounded border border-line bg-surface-2 px-3 py-2 opacity-60">
          <b class="text-heading">${v?.name ?? '?'}</b>
          <span class="text-clay"> · cpu limit — retry</span>
        </div>`;
        })
        .join('');
      cap.textContent =
        answered === rs.length
          ? `one signal → ${rs.length} wirings → ${new Set(rs.map((r) => (r.status === 'fulfilled' && 'verdict' in r.value ? r.value.verdict.spike_digest : ''))).size} distinct answers — each replayable bit-for-bit`
          : `one signal → ${answered} of ${rs.length} wirings answered — the biggest brains exceed this plan's compute budget; retry fires them again`;
    } catch (e) {
      cap.textContent = 'call failed: ' + e;
    } finally {
      btn.disabled = false;
    }
  });
</script>
