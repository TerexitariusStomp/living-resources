---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Lane table — rendered from src/data/lanes.json, which must stay in sync
// with deploy/policies/living/lane-gate.rego (checked by tools/site/lane_drift.py).
import lanes from '~/data/lanes.json';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

interface Props {
  id?: string;
  mode?: 'plain' | 'tech';
  title?: string;
  tagline?: string;
  subtitle?: string;
}
const { id, mode = 'plain' } = Astro.props;

const badgeClass: Record<string, string> = {
  live: 'text-[#00d992] border-[#00d992]/40 bg-[#00d992]/10',
  built: 'text-sky-300 border-sky-400/40 bg-sky-400/10',
  consent: 'text-amber-300 border-amber-400/40 bg-amber-400/10',
  refused: 'text-red-400/90 border-red-500/30 bg-red-500/5',
};
---

<WidgetWrapper id={id} containerClass="max-w-5xl">
  <div class="font-mono text-sm">
    {
      lanes.map((l) => (
        <div class="grid md:grid-cols-[7rem_11rem_1fr] gap-x-5 gap-y-1 border-b border-white/10 py-3.5">
          <span class="text-heading font-semibold">{mode === 'tech' ? l.id : l.plain}</span>
          <span>
            <span
              class={`inline-block rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${badgeClass[l.tier]}`}
            >
              {l.badge}
            </span>
          </span>
          <span class="text-muted leading-relaxed">
            {mode === 'tech' ? l.desc : l.desc}
            {mode === 'tech' && <span class="block text-xs opacity-60 mt-1">{l.src}</span>}
          </span>
        </div>
      ))
    }
    <p class="text-muted text-xs pt-4">
      // lanes graduate experiment → offer only when their evidence fingerprint lands. Receipts are the product; the
      rest is a research program with the brakes on.
    </p>
  </div>
</WidgetWrapper>
