---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Lane table — rendered from src/data/lanes.json, which must stay in sync
// with deploy/policies/living/lane-gate.rego (checked by tools/site/lane_drift.py).
// Plain mode: plain-language badges + descriptions from tiers.json/plainDesc.
// Tech mode: gate lane names + technical descriptions (used on /developers).
import lanes from '~/data/lanes.json';
import tiers from '~/data/tiers.json';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { TierKey } from '~/utils/tiers';

interface Props {
  id?: string;
  mode?: 'plain' | 'tech';
  title?: string;
  tagline?: string;
  subtitle?: string;
}
const { id, mode = 'plain' } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-5xl">
  <div class="font-mono text-sm">
    {
      lanes.map((l) => (
        <div class="grid md:grid-cols-[7rem_11rem_1fr] gap-x-5 gap-y-1 border-b border-white/10 py-3.5">
          <span class="text-heading font-semibold">{mode === 'tech' ? l.id : l.plain}</span>
          <span>
            <span
              class={`inline-block rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${tiers[l.tier as TierKey].class}`}
            >
              {mode === 'tech' ? l.badge : tiers[l.tier as TierKey].label}
            </span>
          </span>
          <span class="text-muted leading-relaxed">
            {mode === 'tech' ? l.desc : (l.plainDesc ?? l.desc)}
            {mode === 'tech' && <span class="block text-xs opacity-60 mt-1">{l.src}</span>}
          </span>
        </div>
      ))
    }
    <p class="text-muted text-xs pt-4">
      {
        mode === 'tech'
          ? '// lanes graduate experiment → offer only when their evidence fingerprint lands. Receipts are the product; the rest is a research program with the brakes on.'
          : 'A lane only earns "works today" when proof lands. The receipt is the product; the rest is research with the brakes on.'
      }
    </p>
  </div>
</WidgetWrapper>
