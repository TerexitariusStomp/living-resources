---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 217 146);
    --aw-color-secondary: rgb(0 160 110);
    --aw-color-accent: rgb(224 166 75);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 62%);
    --aw-color-bg-page: rgb(5 5 7);

    --aw-color-bg-page-dark: rgb(16 16 16);

    ::selection {
      background-color: rgb(0 217 146);
      color: rgb(5 5 7);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 217 146);
    --aw-color-secondary: rgb(127 166 106);
    --aw-color-accent: rgb(224 166 75);

    --aw-color-text-heading: rgb(242 234 223);
    --aw-color-text-default: rgb(222 226 218);
    --aw-color-text-muted: rgb(222 226 218 / 62%);
    --aw-color-bg-page: rgb(5 5 7);

    ::selection {
      background-color: rgb(0 217 146);
      color: rgb(5 5 7);
    }
  }
</style>
