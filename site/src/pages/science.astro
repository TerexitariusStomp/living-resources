---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import LaneTable from '~/components/living/LaneTable.astro';
import Features2 from '~/components/widgets/Features2.astro';
import cloud from '~/data/cloud.json';

const metadata = { title: 'The science — every claim tiered' };

const tierCards = [
  { title: 'real today', description: 'running, deployed, replayable', icon: 'tabler:circle-check' },
  { title: 'built · pending', description: 'tested end-to-end, field gate unrun', icon: 'tabler:tool' },
  { title: 'consent-gated', description: 'implemented, locked behind joint consent', icon: 'tabler:key' },
  { title: 'the vision', description: 'what the network is building toward', icon: 'tabler:telescope' },
  { title: 'refused', description: 'out of bounds until evidence earns it', icon: 'tabler:ban' },
];

// each homepage section, honestly
const sections = [
  {
    id: 'plant-sound',
    tier: 'real — published field science',
    color: 'text-[#00d992]',
    title: '"A thirsty plant makes a sound"',
    body: `The clicks are real — recorded by Khait et al., published in <em>Cell</em> 2023, released CC0 on Dryad. What you
      hear is a ~11× slowdown of actual 500&nbsp;kHz recordings; the plant's own signal, transposed into human hearing.
      Our hardware can't yet record those — field validation (E0) is pending.
      <a class="underline" href="https://doi.org/10.1016/j.cell.2023.03.009">paper</a> ·
      <a class="underline" href="https://doi.org/10.5061/dryad.jwstqjqf7">data</a>`,
  },
  {
    id: 'listener',
    tier: 'built — field validation pending',
    color: 'text-sky-300',
    title: '"A $40 listener that never touches"',
    body: `EcoCell One exists as a manufacturable KiCad board (real Gerbers, pick-and-place files) plus MicroPython
      firmware that passes its e2e suites. It has not yet been deployed in a field pilot — that is what E0 tests.`,
  },
  {
    id: 'loop',
    tier: 'the vision — mechanics built',
    color: 'text-amber-300',
    title: '"When nature earns, people protect it"',
    body: `The mechanism is implemented and e2e-tested — quorum witnessing (<code>attest.scm</code>), per-contribution
      mutual credit (<code>settlement.scm</code>), guardian custody (<code>agents.scm</code>). Whether that changes
      real-world protection economics is the hypothesis this project exists to test — not a measured result.`,
  },
  {
    id: 'network',
    tier: 'real — one lane live',
    color: 'text-[#00d992]',
    title: '"Fifteen living wirings answer"',
    body: `Live today: deterministic LIF tasks over 15 EM-derived connectome wirings, every receipt replayable — TS port
      verified bit-identical to the Python engine (930/930 checks). The globe markers are places the living cloud
      <em>could</em> listen; no field nodes are deployed yet.`,
  },
  {
    id: 'promises',
    tier: 'enforced in code',
    color: 'text-[#00d992]',
    title: '"Four rules"',
    body: `Not aspirations — code. The lane gate (<code>lane-gate.rego</code> / <code>offers.scm</code>) admits evidence
      lanes only with an evidence fingerprint, consent lanes only with a joint guardian+operator credential, and
      refuses <code>hop</code>, <code>compute</code>, and <code>engineered</code> outright. 93/93 e2e checks pass.`,
  },
  {
    id: 'cloud-map',
    tier: 'the vision — trajectory, honestly split',
    color: 'text-amber-300',
    title: '"The living cloud"',
    body: `The next-cloud thesis, on the record: we lose on latency, throughput and bulk storage <em>today</em> and say
      so. Energy per synapse and storage density carry field evidence. The rest is a roadmap, marked as such below.`,
  },
];

type Row = { claim: string; note: string; bad?: boolean };
const measured: Row[] = [
  {
    claim: 'Packed int4 CSR wiring is <b>46×–5,900× smaller</b> than fp32 dense weights',
    note: 'measured bytes · celegans → medulla · <a class="underline" href="https://github.com/treetable/living-resources/blob/main/docs/EFFICIENCY.md">EFFICIENCY.md</a>',
  },
  {
    claim: 'At ≥10⁴ neurons, connectome legs use <b>~70× fewer joules</b> than dense fp32 on the same silicon',
    note: 'measured RAPL · medulla 0.117 J vs 8.30 J · 3.3 ms vs 104 ms',
  },
  {
    claim: 'Deterministic traces replay <b>bit-for-bit</b> — TS port identical to the Python engine',
    note: '930/930 checks · workers/compute-api/test/diff.mjs',
  },
  {
    claim: 'At 302 neurons the interpreter is <b>~20× slower</b> than SIMD — reported, not hidden',
    note: 'measured — unfavorable cells are part of the evidence',
    bad: true,
  },
  {
    claim: 'Shuffled wiring with identical degree statistics performs <b>identically</b>',
    note: 'measured control — the win is sparsity; biology contributes the signature, not the speed',
    bad: true,
  },
];

const field: Row[] = [
  {
    claim: 'Stressed plants emit <b>remotely detectable, informative ultrasound</b> — tomato ~35 clicks/h, 20–100 kHz',
    note: '<a class="underline" href="https://doi.org/10.1016/j.cell.2023.03.009">Khait et al., Cell 2023</a> — one replication attempt (Göttingen 2025, doi:10.25625/13agyl) found no peaks; we cite the original and welcome adversarial checks',
  },
  {
    claim: 'Biofilms broadcast <b>K⁺ electrical waves</b> that attract distant cells across species',
    note: '<a class="underline" href="https://doi.org/10.1038/nature15709">Prindle et al., Nature 2015</a> · <a class="underline" href="https://doi.org/10.1016/j.cell.2016.12.012">Humphries et al., Cell 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.aah4204">Liu et al., Science 2017</a>',
  },
  {
    claim: 'Reef acoustic complexity <b>tracks biodiversity and recovery</b>',
    note: '<a class="underline" href="https://doi.org/10.1111/1365-2664.14274">J Appl Ecol 2022</a>',
  },
  {
    claim: 'DNA archival storage reaches <b>215 petabytes per gram</b>',
    note: '<a class="underline" href="https://doi.org/10.1126/science.aaj2038">Erlich &amp; Zielinski, Science 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.1226355">Church et al., Science 2012</a> — field evidence for biological density, <b>not our lane</b>',
  },
  {
    claim: 'Neuromorphic silicon runs at <b>~24–26 pJ per synaptic event</b>; a biological synapse ~1–100 pJ',
    note: '<a class="underline" href="https://doi.org/10.1126/science.1254642">Merolla et al., Science 2014</a> · <a class="underline" href="https://doi.org/10.1109/MM.2018.112130359">Davies et al., IEEE Micro 2018</a> — cited, unverified by us',
  },
];
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-5xl pt-8">
    <Headline
      tagline="How real is it?"
      title="Every claim wears its tier"
      subtitle="The homepage speaks in the future tense. Here is what actually exists — measured by us, demonstrated by the field, pending validation, gated by consent, or refused outright. If it isn't in a tier below, we don't claim it."
    />
    <Features2 columns={3} classes={{ container: 'pb-0 md:pb-0 lg:pb-0' }} items={tierCards} />
  </WidgetWrapper>

  <!-- homepage section ↔ tier map -->
  <WidgetWrapper id="tiers" containerClass="max-w-5xl">
    <Headline title="Each homepage section, honestly" classes={{ title: 'text-2xl md:text-3xl' }} />
    <div class="space-y-6 text-default">
      {
        sections.map((s) => (
          <div id={s.id} class="scroll-mt-24 rounded-lg border border-white/10 bg-black/30 p-5">
            <div class={`mb-1 font-mono text-xs uppercase tracking-wide ${s.color}`}>{s.tier}</div>
            <h3 class="mb-1 font-semibold text-heading">{s.title}</h3>
            <p class="text-muted text-sm leading-relaxed" set:html={s.body} />
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- lane table -->
  <LaneTable id="lanes" mode="plain" />

  <!-- the living cloud vs conventional cloud — per-axis honesty -->
  <WidgetWrapper id="cloud" containerClass="max-w-5xl scroll-mt-24">
    <Headline
      tagline="The next cloud, honestly"
      title="Where the living cloud stands against the conventional one"
      subtitle="The conventional cloud hosts our verification layer today. The living cloud supplies what no facility can manufacture — the biosphere's own testimony. On the four axes people ask about, here is exactly where we stand."
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="space-y-3">
      {
        cloud.axes.map((a) => (
          <div class="rounded-lg border border-white/10 bg-black/30 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold text-heading">{a.axis}</h3>
              <span
                class:list={[
                  'font-mono text-xs uppercase tracking-wide',
                  a.good ? 'text-[#00d992]' : 'text-red-400/80',
                ]}
              >
                {a.status}
              </span>
            </div>
            <div class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
              <p class="text-muted">
                <span class="text-default font-mono text-xs uppercase tracking-wide">today — </span>
                {a.today}
              </p>
              <p class="text-muted">
                <span class="text-default font-mono text-xs uppercase tracking-wide">field — </span>
                <span set:html={a.field} />
              </p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-6 font-mono text-xs" set:html={cloud.thesis} />
  </WidgetWrapper>

  <!-- measured vs cited -->
  <WidgetWrapper id="evidence" containerClass="max-w-6xl">
    <Headline
      tagline="The evidence"
      title="Measured by us · demonstrated by the field"
      subtitle="Our numbers are replay-verifiable from the repo. Field numbers are cited to their papers — and we say which lanes they do and do not support."
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="grid gap-6 md:grid-cols-2">
      {
        [
          { title: 'measured — replay-verifiable', color: 'text-[#00d992]', rows: measured },
          { title: 'demonstrated by the field', color: 'text-amber-300', rows: field },
        ].map((col) => (
          <div>
            <h3 class={`mb-3 font-mono text-sm uppercase tracking-wide ${col.color}`}>{col.title}</h3>
            <div class="space-y-3">
              {col.rows.map((r) => (
                <div
                  class:list={[
                    'rounded-lg border p-4',
                    r.bad ? 'border-red-500/20 bg-red-500/5' : 'border-white/10 bg-black/30',
                  ]}
                >
                  <p class="text-sm text-default" set:html={r.claim} />
                  <p class="text-muted mt-1 text-xs" set:html={r.note} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-8 font-mono text-xs">
      // the field has shown what is physically possible. our contribution is narrower and checkable: the receipts. full
      claim table → <a
        class="text-[#00d992] underline"
        href="https://github.com/treetable/living-resources/blob/main/docs/SCIENCE.md">docs/SCIENCE.md</a
      >
    </p>
  </WidgetWrapper>
</Layout>
