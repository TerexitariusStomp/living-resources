---
import Layout from '~/layouts/Layout.astro';
import LostForest from '~/components/art/LostForest.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <LostForest />
        <h2 class="mb-4 mt-8 font-bold text-4xl font-heading">
          <span class="sr-only">Error 404 —</span>
          This path grew over.
        </h2>
        <p class="mt-4 mb-8 text-lg text-muted">
          The page you were looking for isn't here — the forest took it back. The living cloud is one click away.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn btn-primary">Back to the living cloud</a>
      </div>
    </div>
  </section>
</Layout>
