      title="Four rules the whole cloud follows"
      columns={2}
      items={[
        {
          title: 'We never attach to living things',
          description:
            'No sensors on plants or animals. Nothing in the soil. Listening from a distance is always the default.',
          icon: 'tabler:hand-off',
        },
        {
          title: 'Nothing is hidden',
          description: 'Every reading and every answer gets a receipt anyone can re-check.',
          icon: 'tabler:eye',
