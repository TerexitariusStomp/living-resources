---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import PlantListen from '~/components/living/PlantListen.astro';
import Board3D from '~/components/living/Board3D.astro';
import Globe from '~/components/living/Globe.astro';
import ValueLoop from '~/components/living/ValueLoop.astro';
import JoinForm from '~/components/living/JoinForm.astro';
import TierLink from '~/components/living/TierLink.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import cloud from '~/data/cloud.json';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'The living cloud — nature, on the record',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1 — the question -->
  <Hero
    badge="The living cloud"
    actions={[
      { variant: 'primary', text: 'Hear a plant', href: '#hear', icon: 'tabler:ear' },
      { text: 'Join as a guardian', href: '#join', icon: 'tabler:leaf' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image:url(/img/hero-forest.jpg)"></div>
      <div class="absolute inset-0 bg-black/70"></div>
    </Fragment>
    <Fragment slot="title">
      What if nature could <span class="text-[#00d992]">speak for itself</span> — and the world listened?
    </Fragment>
    <Fragment slot="subtitle">
      We're building a planet-wide network that hears forests, reefs and soils — <b>without touching them</b>. What they
      say gets witnessed, recorded forever, and credited back to them. When nature has a voice and an income,
      <b>keeping it alive becomes the obvious choice.</b>
    </Fragment>
  </Hero>

  <!-- 2 — hear it -->
  <WidgetWrapper id="hear" containerClass="max-w-4xl">
    <Headline
      tagline="Real science · press play"
      title="A thirsty plant makes a sound"
      subtitle="In 2023, researchers at Tel Aviv University put ultrasonic microphones next to tomato plants. When the soil dried out, the plants started clicking — about 35 times an hour — too high-pitched for us to hear. Slowed down so we can hear it, it sounds like this:"
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    <PlantListen />
    <TierLink anchor="plant-sound" />
  </WidgetWrapper>

  <!-- 3 — the listener -->
  <WidgetWrapper id="listener" containerClass="max-w-6xl">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <Headline
          tagline="One small box"
          title="A $40 listener that never touches what it hears"
          subtitle="A weatherproof node with ears, eyes and an ultrasonic sense — left near living systems, never on them. Nothing attaches to an organism. Nothing goes into the soil. It just… listens."
          classes={{ container: 'md:mx-0 md:text-left mb-6' }}
        />
        <ul class="text-muted space-y-2 text-base">
          <li><b class="text-heading">Hears</b> — birdsong, insect hum, plant ultrasound</li>
          <li><b class="text-heading">Sees</b> — camera, weather, soil conductivity nearby</li>
          <li><b class="text-heading">Never touches</b> — passive by design, not by promise</li>
          <li><b class="text-heading">Talks</b> — only when guardian and operator both say yes</li>
        </ul>
        <TierLink anchor="listener" />
      </div>
      <Board3D />
    </div>
  </WidgetWrapper>

  <!-- 4 — the loop -->
  <WidgetWrapper id="loop" isDark containerClass="max-w-6xl">
    <Headline
      tagline="The loop that changes the economics"
      title="When nature earns, people protect it"
      subtitle="Today a forest is worth more as timber than as a living system — that is why it disappears. If a forest can be heard, its signals verified, and its contributions credited, being alive starts to pay. We want more of what pays."
      classes={{ container: 'max-w-4xl' }}
    />
    <ValueLoop />
    <div class="mt-6 text-center"><TierLink anchor="loop" /></div>
  </WidgetWrapper>

  <!-- 5 — the network -->
  <WidgetWrapper id="network" containerClass="max-w-6xl">
    <Headline
      tagline="One network, every living system"
      title="Try it — fifteen living wirings are already answering"
      subtitle="Send one signal into the network and fifteen real nervous-system wirings — mapped from actual organisms — each give a different, checkable answer. Every answer comes with a receipt anyone can replay."
      classes={{ container: 'max-w-4xl' }}
    />
    <Globe />
    <div class="mt-4 text-center"><TierLink anchor="network" /></div>
  </WidgetWrapper>

  <!-- 6 — the next cloud -->
  <WidgetWrapper id="cloud" isDark containerClass="max-w-6xl">
    <Headline
      tagline="The next cloud"
      title="The cloud is going living"
      subtitle="The first clouds were buildings full of silicon. The next one is alive — the same job, compute and storage and answers you can trust, run on the biosphere itself. For the cost of one AI campus you could field ~750,000 listeners."
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="mx-auto mb-12 grid max-w-4xl gap-4 sm:grid-cols-3">
      {
        cloud.stats.map((s) => (
          <div class="rounded-lg border border-white/10 bg-black/30 p-5 text-center">
            <div class="font-heading text-2xl font-bold text-[#00d992]">{s.value}</div>
            <div class="text-default mt-1 text-sm">{s.label}</div>
            <div class="text-muted mt-1 font-mono text-xs">{s.note}</div>
          </div>
        ))
      }
    </div>
    <Comparison
      mode="versus"
      firstColumnLabel={cloud.comparison.firstColumnLabel}
      columns={cloud.comparison.columns}
      rows={cloud.comparison.rows}
    />
    <div class="mx-auto mt-16 max-w-3xl">
      <Timeline items={cloud.trajectory} layout="vertical" />
      <p class="text-muted mt-8 border-l-2 border-[#00d992]/40 pl-4 text-sm italic">{cloud.thesis}</p>
    </div>
    <div class="mt-6 text-center"><TierLink anchor="cloud" /></div>
  </WidgetWrapper>

  <!-- 7 — why you'd want more of it -->
  <Features
    id="why"
    tagline="Why it matters to you"
    title="If this works, nature stops being invisible"
    subtitle="The same signals that credit ecosystems are useful to every human:"
    columns={3}
    items={[
      {
        title: 'Water & food',
        description:
          'A thirsty field clicks before it wilts. A stressed forest sings before it burns. Hearing early is cheaper than losing late.',
        icon: 'tabler:droplet',
      },
      {
        title: 'Early warning',
        description:
          'Disease in crops, stress in reefs, silence in a wetland — detected as sound, days before it is visible.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Proof, not promises',
        description:
          'Every claim carries a receipt that replays bit-for-bit. Regulators, funders and sceptics can check the same number.',
        icon: 'tabler:file-check',
      },
      {
        title: 'A share for nature',
        description:
          'Ecosystems earn credit for what they contribute — a new way for a forest to pay for its own protection.',
        icon: 'tabler:coin',
      },
      {
        title: 'Nature can refuse',
        description:
          'Consent is built into the protocol. A living system that does not want to be read stays unread — and that refusal is on the record.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'A new coexistence',
        description:
          'Not extracting from nature, not ignoring it — listening to it, crediting it, and letting it say no.',
        icon: 'tabler:leaf',
      },
    ]}
  />

  <!-- 8 — promises -->
  <Steps
    id="promises"
    tagline="What we promise, in writing"
    title="Four rules the whole network runs on"
    items={[
      {
        title: 'We never attach to living things',
        description:
          'No sensors on organisms. No probes in soil. No anchors. Passive listening is the default, permanently.',
        icon: 'tabler:hand-off',
      },
      {
        title: 'Nothing is hidden',
        description:
          'Every reading, every computation, every refusal ships as a content-addressed receipt that anyone can replay and check.',
        icon: 'tabler:eye',
      },
      {
        title: 'Nature holds a voice',
        description:
          'Each ecological subject has a human guardian with custody — and the subject keeps voice 0, including the right to refuse.',
        icon: 'tabler:users',
      },
      {
        title: 'The brakes stay on',
        description:
          'Writing into living systems needs joint consent. Asking organisms to compute or relay stays refused until evidence earns it.',
        icon: 'tabler:lock',
      },
    ]}
    image={{ src: '/img/forest-floor.jpg', alt: 'Forest floor with fungi and moss — public domain, Bernard Spragg' }}
  />

  <!-- 9 — FAQ -->
  <FAQs
    id="faq"
    tagline="Fair questions"
    title="Asked, answered honestly"
    collapsible
    items={[
      {
        title: 'Are plants really talking?',
        description:
          'Really emitting detectable sounds — published in Cell, 2023. Whether it is "language" is a bigger claim than ours: we listen, verify, and keep the receipts.',
      },
      {
        title: 'Is this computing with living things?',
        description:
          'No — not today, and we say so on the page. What runs now is deterministic simulation over real connectome wiring maps. The lane called "compute (organism)" is explicitly refused until evidence earns it.',
      },
      {
        title: 'Who gets the credit?',
        description:
          'The ecological subject earns it; its human guardian holds custody of it. Per-contribution, replay-verifiable.',
      },
      {
        title: 'Can I host a listener?',
        description:
          'Soon. EcoCell One is a ~$35–45 open-hardware node — join the waitlist below and pick "host a listener".',
      },
      {
        title: 'Is it open source?',
        description:
          'Fully — AGPL-3.0-or-later, hardware included. Everything on this page that exists is in the repository.',
      },
      {
        title: "Isn't this just a sensor network?",
        description:
          'The difference is who the data belongs to. Here the subject is a participant with custody, consent and credit — not a resource being metered.',
      },
    ]}
  />

  <!-- 10 — join -->
  <WidgetWrapper id="join" isDark containerClass="max-w-3xl">
    <Headline
      tagline="Be part of it"
      title="Join the living cloud"
      subtitle="Guardians, hosts, funders, scientists, the curious — one list, one email when field pilots open."
    />
    <JoinForm />
  </WidgetWrapper>
</Layout>
