---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import PlantListen from '~/components/living/PlantListen.astro';
import Board3D from '~/components/living/Board3D.astro';
import Globe from '~/components/living/Globe.astro';
import WebNode from '~/components/living/WebNode.astro';
import FedLive from '~/components/living/FedLive.astro';
import Details from '~/components/living/Details.astro';
import ValueLoop from '~/components/living/ValueLoop.astro';
import OrganismMap from '~/components/living/OrganismMap.astro';
import LaneTable from '~/components/living/LaneTable.astro';
import JoinForm from '~/components/living/JoinForm.astro';
import TierLink from '~/components/living/TierLink.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import cloud from '~/data/cloud.json';
import market from '~/data/market.json';
import federation from '~/data/federation.json';
import tiers from '~/data/tiers.json';
import { tierChip, type TierKey } from '~/utils/tiers';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'The living cloud — a cloud made of living nature',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const chips = (keys: TierKey[]) => keys.map(tierChip).join(' ');

const jobs = [
  {
    title: 'Listen',
    icon: 'tabler:ear',
    description: `Small boxes sit near plants, reefs and soil and hear what is going on. They never touch anything.<br/>${chips(['built'])}`,
  },
  {
    title: 'Check',
    icon: 'tabler:receipt',
    description: `Every answer gets a receipt: a digital seal anyone can re-check. Change one letter and the seal breaks.<br/>${chips(['live'])}`,
  },
  {
    title: 'Think',
    icon: 'tabler:route',
    description: `Today, computers run maps of real animal nerves — like subway maps of tiny brains. Someday, nature may do the thinking itself.<br/>${chips(['live', 'vision'])}`,
  },
  {
    title: 'Remember',
    icon: 'tabler:dna',
    description: `Today we keep receipts. Someday, data could live in DNA, nature's own storage, using a gentle method nobody has invented yet.<br/>${chips(['live', 'vision'])}`,
  },
];

const journey = [
  {
    date: 'Proven by scientists',
    title: 'A plant makes a signal',
    description:
      'A tomato plant runs low on water and starts clicking. Scientists recorded this in 2023. Nobody touches the plant. It is just being itself.',
    icon: 'tabler:plant',
  },
  {
    date: 'Built — field test next',
    title: 'A listener hears it',
    description:
      'A small box sits nearby, not on the plant. Its microphone picks up the click. The box never touches the plant or the soil.',
    icon: 'tabler:ear',
  },
  {
    date: 'Built — field test next',
    title: 'Several listeners agree',
    description:
      'One box could be wrong. So the cloud waits until several boxes agree, like three friends who all saw the same goal. Scientists call this a quorum.',
    icon: 'tabler:users-group',
  },
  {
    date: 'Works today',
    title: 'A receipt is made',
    description:
      "The cloud writes down what happened and seals it with a code. Anyone can redo the work and get the same code. If anything was changed, the code won't match.",
    icon: 'tabler:receipt',
    highlight: true,
  },
  {
    date: 'Works today',
    title: 'The cloud thinks it over',
    description:
      'The signal runs through maps of real animal nerves, called connectomes. They are like subway maps of tiny brains. Today a regular computer runs these maps. No animal is involved.',
    icon: 'tabler:route',
    highlight: true,
  },
  {
    date: 'Built — field test next',
    title: 'Nature earns credit',
    description:
      "The plant's patch of nature earns credit for what it shared. Its AI companion keeps the record, and a human guardian looks after the credit, like a grown-up managing a kid's savings.",
    icon: 'tabler:coin',
  },
  {
    date: 'Someday',
    title: 'People protect what pays',
    description:
      'When a living forest earns more than a cut-down one, people have a reason to keep it. That is the idea we are testing.',
    icon: 'tabler:leaf',
    ghost: true,
  },
  {
    date: 'Someday',
    title: 'The organism gets better',
    description:
      'Every new version of the living cloud must prove with receipts that it uses less power, space and time. Over time, more work moves to nature — with proof and permission.',
    icon: 'tabler:trending-down',
    ghost: true,
  },
];

const concepts = [
  {
    title: 'The living cloud',
    icon: 'tabler:cloud',
    description:
      'A cloud is a network that listens, checks, thinks and remembers. Ours uses nature and small boxes instead of giant buildings.',
  },
  {
    title: 'The AI organism',
    icon: 'tabler:atom-2',
    description: `All the AI companions, boxes, receipts and brain maps working together like one living thing. It grows by using less.<br/>${chips(['vision'])}`,
  },
  {
    title: 'AI companion',
    icon: 'tabler:robot',
    description: `Each forest, reef or field gets its own helper that keeps its records, follows its guardian's choices and speaks up for it. Today it is a simple rule-following program.<br/>${chips(['built'])}`,
  },
  {
    title: 'Listener',
    icon: 'tabler:ear',
    description: `Like a weather station with ears. About $40, sun-powered, never touches anything.<br/>${chips(['built'])}`,
  },
  {
    title: 'Signal',
    icon: 'tabler:wave-sine',
    description: `Anything nature gives off that we can sense from far away: a click, a bird song, a change in the water.<br/>${chips(['science'])}`,
  },
  {
    title: 'Quorum',
    icon: 'tabler:users-group',
    description: `Like a video review in sports: one camera angle isn't enough, several have to agree.<br/>${chips(['built'])}`,
  },
  {
    title: 'Receipt',
    icon: 'tabler:receipt',
    description: `Like a sealed envelope with a fingerprint. Open it, redo the work, and the fingerprint must match.<br/>${chips(['live'])}`,
  },
  {
    title: 'Connectome',
    icon: 'tabler:route',
    description: `A map of every nerve in a small animal's brain, like a subway map. We run these maps on computers.<br/>${chips(['live'])}`,
  },
  {
    title: 'Guardian',
    icon: 'tabler:user-shield',
    description: `A person who looks after a plant, animal group or place, like a coach or a parent. They hold its credit and its choices.<br/>${chips(['built'])}`,
  },
  {
    title: 'Voice 0',
    icon: 'tabler:hand-stop',
    description: `Nature always speaks first and can say no. If it says no, nothing happens, and the 'no' is written down.<br/>${chips(['built'])}`,
  },
  {
    title: 'Credit',
    icon: 'tabler:coin',
    description: `Points nature earns for what it shares, kept like a savings account.<br/>${chips(['built'])}`,
  },
  {
    title: 'Realm',
    icon: 'tabler:map-pin-heart',
    description: `Guardians of Earth's word for a place with its own caretakers and score. A partner network we are building alongside.<br/>${chips(['federated'])}`,
  },
  {
    title: 'Web node',
    icon: 'tabler:device-mobile',
    description: `Your own phone or laptop as a listener. The browser asks first, checking happens on the device, and you can take it back any time.<br/>${chips(['federated'])}`,
  },
  {
    title: 'Market report',
    icon: 'tabler:chart-line',
    description: `An estimate of how much people spend on something, written by market researchers. Useful direction, not a measurement.<br/>${chips(['market'])}`,
  },
];

// each section's claim, honestly — technical footnotes, skipped by the readability gate
const honesty = [
  {
    id: 'truth-jobs',
    tier: 'mixed — the four jobs wear different labels',
    color: 'text-[#00d992]',
    title: '"Every cloud has four jobs"',
    body: `Listen — <b>built</b>, field test E0 next. Check — <b>works today</b> via the live receipt API
      (<code>/verify</code>). Think — <b>works today</b> on silicon over real connectomes; organism compute itself is
      refused. Remember — receipts <b>today</b>; organism-bound store is <b>consent-gated</b>; DNA storage is
      <b>someday</b>. The split is the point.`,
  },
  {
    id: 'truth-plant-sound',
    tier: 'real — published field science',
    color: 'text-[#00d992]',
    title: '"A thirsty plant makes a sound"',
    body: `The clicks are real — recorded by Khait et al., published in <em>Cell</em> 2023, released CC0 on Dryad. What you
      hear is a ~11× slowdown of actual 500&nbsp;kHz recordings; the plant's own signal, transposed into human hearing.
      Our hardware can't yet record those — field validation (E0) is pending.
      <a class="underline" href="https://doi.org/10.1016/j.cell.2023.03.009">paper</a> ·
      <a class="underline" href="https://doi.org/10.5061/dryad.jwstqjqf7">data</a>`,
  },
  {
    id: 'truth-listener',
    tier: 'built — field validation pending',
    color: 'text-sky-300',
    title: '"A $40 box that listens without touching"',
    body: `EcoCell One exists as a manufacturable KiCad board (real Gerbers, pick-and-place files) plus MicroPython
      firmware that passes its e2e suites. It has not yet been deployed in a field pilot — that is what E0 tests.`,
  },
  {
    id: 'truth-loop',
    tier: 'the vision — mechanics built',
    color: 'text-amber-300',
    title: '"When nature earns, people protect it"',
    body: `The mechanism is implemented and e2e-tested — quorum witnessing (<code>attest.scm</code>), per-contribution
      mutual credit (<code>settlement.scm</code>), guardian custody (<code>agents.scm</code>). Whether that changes
      real-world protection economics is the hypothesis this project exists to test — not a measured result.`,
  },
  {
    id: 'truth-network',
    tier: 'real — one lane live',
    color: 'text-[#00d992]',
    title: '"15 real brain maps answer you"',
    body: `Live today: deterministic LIF tasks over 15 EM-derived connectome wirings, every receipt replayable — TS port
      verified bit-identical to the Python engine (930/930 checks). The globe markers are places the living cloud
      <em>could</em> listen; no field nodes are deployed yet.`,
  },
  {
    id: 'truth-promises',
    tier: 'enforced in code',
    color: 'text-[#00d992]',
    title: '"Four rules the whole cloud follows"',
    body: `Not aspirations — code. The lane gate (<code>lane-gate.rego</code> / <code>offers.scm</code>) admits evidence
      lanes only with an evidence fingerprint, consent lanes only with a joint guardian+operator credential, and
      refuses <code>hop</code>, <code>compute</code>, and <code>engineered</code> outright. 93/93 e2e checks pass.`,
  },
  {
    id: 'truth-cloud-map',
    tier: 'the vision — trajectory, honestly split',
    color: 'text-amber-300',
    title: '"The cloud is going living"',
    body: `The next-cloud thesis, on the record: one step at a time, silicon wins <em>today</em> — measured and we
      say so. Per watt and at scale, published evidence already favors living systems; turning that into useful work
      is the roadmap above.`,
  },
  {
    id: 'truth-organism',
    tier: 'the vision — a metaphor over real parts',
    color: 'text-violet-300',
    title: '"An AI organism that grows with nature"',
    body: `The nested organism is a metaphor over real parts. Each ecosystem's companion is an <code>^eco-agent</code>
      actor (<code>agents.scm</code>, e2e-tested): a capability-secure record with guardian custody and voice 0 —
      <b>not a learning model</b>. The ears already use AI: OpenSoundscape/BirdNET models via
      <code>classify.py</code>, with an energy-gate fallback. Duty-cycling runs on fixed dawn/dusk windows, re-tunable
      by a consent-gated <code>duty</code> downlink; autonomous tuning is not built. The sparse-wiring footprint is
      measured (46×–5,900× smaller, ~70× J at medulla) — and the degree-matched shuffle control shows the gain is
      <b>sparsity</b>, not biological topology. Generational replace-only-if-receipts-show-less is a proposed rule,
      measurable today with E6 replay bundles, not yet enforced. Moving work into living systems stays behind the
      consent and refused lanes.`,
  },
  {
    id: 'truth-federation',
    tier: 'their devices, their numbers — labeled',
    color: 'text-cyan-300',
    title: '"Already listening — nature\'s other ears"',
    body: `The device counts are the networks' own published numbers, spot-checked live (BirdWeather's public graph
      returned 26k+ stations when we looked). Federated imports ride provenance — each record names whose device
      heard it — and are never shown as our quorum. Writes are different: every actuator is owner-keyed.
      <b>Open-invitation</b> means a stranger may drive it under the owner's published terms (FarmBot's demo garden
      is the working example); <b>opt-in</b> fleets mean the owner must volunteer. Nobody's device is reachable by
      default. Your browser's permission prompt is the operator consent — and nothing is recorded unless you say yes.`,
  },
  {
    id: 'truth-market',
    tier: 'the vision — cited estimates',
    color: 'text-orange-300',
    title: '"Proof is a product people already pay for"',
    body: `Market sizes are third-party research estimates, cited — not our measurements. Pricing tiers are real
      numbers from our funding docs, but billing isn't wired and no revenue is claimed. The ladder is the plan, in
      order: services → hardware → catalogue → credit rails.`,
  },
];

type Row = { claim: string; note: string; bad?: boolean };
const measured: Row[] = [
  {
    claim: 'Packed int4 CSR wiring is <b>46×–5,900× smaller</b> than fp32 dense weights',
    note: 'measured bytes · celegans → medulla · <a class="underline" href="https://github.com/treetable/living-resources/blob/main/docs/EFFICIENCY.md">EFFICIENCY.md</a>',
  },
  {
    claim: 'At ≥10⁴ neurons, connectome legs use <b>~70× fewer joules</b> than dense fp32 on the same silicon',
    note: 'measured RAPL · medulla 0.117 J vs 8.30 J · 3.3 ms vs 104 ms',
  },
  {
    claim: 'Deterministic traces replay <b>bit-for-bit</b> — TS port identical to the Python engine',
    note: '930/930 checks · workers/compute-api/test/diff.mjs',
  },
  {
    claim: 'At 302 neurons the interpreter is <b>~20× slower</b> than SIMD — reported, not hidden',
    note: 'measured — unfavorable cells are part of the evidence',
    bad: true,
  },
  {
    claim: 'Shuffled wiring with identical degree statistics performs <b>identically</b>',
    note: 'measured control — the win is sparsity; biology contributes the signature, not the speed',
    bad: true,
  },
];

const field: Row[] = [
  {
    claim: 'Stressed plants emit <b>remotely detectable, informative ultrasound</b> — tomato ~35 clicks/h, 20–100 kHz',
    note: '<a class="underline" href="https://doi.org/10.1016/j.cell.2023.03.009">Khait et al., Cell 2023</a> — one replication attempt (Göttingen 2025, doi:10.25625/13agyl) found no peaks; we cite the original and welcome adversarial checks',
  },
  {
    claim: 'Biofilms broadcast <b>K⁺ electrical waves</b> that attract distant cells across species',
    note: '<a class="underline" href="https://doi.org/10.1038/nature15709">Prindle et al., Nature 2015</a> · <a class="underline" href="https://doi.org/10.1016/j.cell.2016.12.012">Humphries et al., Cell 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.aah4204">Liu et al., Science 2017</a>',
  },
  {
    claim: 'Reef acoustic complexity <b>tracks biodiversity and recovery</b>',
    note: '<a class="underline" href="https://doi.org/10.1111/1365-2664.14274">J Appl Ecol 2022</a>',
  },
  {
    claim: 'DNA archival storage reaches <b>215 petabytes per gram</b>',
    note: '<a class="underline" href="https://doi.org/10.1126/science.aaj2038">Erlich &amp; Zielinski, Science 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.1226355">Church et al., Science 2012</a> — field evidence for biological density, <b>not our lane</b>',
  },
  {
    claim: 'Neuromorphic silicon runs at <b>~24–26 pJ per synaptic event</b>; a biological synapse ~1–100 pJ',
    note: '<a class="underline" href="https://doi.org/10.1126/science.1254642">Merolla et al., Science 2014</a> · <a class="underline" href="https://doi.org/10.1109/MM.2018.112130359">Davies et al., IEEE Micro 2018</a> — cited, unverified by us',
  },
  {
    claim:
      'A brain does an estimated <b>10¹³–10¹⁶ ops/s on ~20 W</b> — ~10×–10,000× more per watt than El Capitan (1.8 EFLOP/s @ 29.7 MW)',
    note: '<a class="underline" href="https://arxiv.org/abs/1602.04019">Sandberg 2016</a> · <a class="underline" href="https://doi.org/10.1073/pnas.2107022118">Levy & Calvert, PNAS 2021</a> · <a class="underline" href="https://www.top500.org/system/180307/">TOP500</a> — cited; synaptic events are not FLOPs',
  },
  {
    claim: 'Commercial wetware already reads and writes living neurons in <b>sub-millisecond cycles</b>',
    note: 'Cortical Labs CL1, 800k neurons, shipping 2025 — <a class="underline" href="https://www.abc.net.au/news/science/2025-03-05/cortical-labs-neuron-brain-chip/104996484">ABC</a> · <a class="underline" href="https://www.forbes.com/sites/johnkoetsier/2025/06/04/hardware-software-meet-wetware-a-computer-with-800000-human-neurons/">Forbes</a> — vendor-reported, unverified by us; lab-grown cells, not our substrate',
  },
  {
    claim: 'DNA data retrieval got <b>3,200× faster</b> with 40% higher accuracy',
    note: '<a class="underline" href="https://doi.org/10.1038/s42256-025-01003-z">Bar-Lev et al., Nature Machine Intelligence 2025</a> — in-vitro pipeline; the non-invasive in-vivo interface remains unknown',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1 — what it is -->
  <Hero
    badge="The living cloud"
    actions={[
      { variant: 'primary', text: 'See how it works', href: '#how', icon: 'tabler:route' },
      { text: 'Hear a plant', href: '#live', icon: 'tabler:ear' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image:url(/img/hero-forest.jpg)"></div>
      <div class="absolute inset-0 bg-black/70"></div>
    </Fragment>
    <Fragment slot="title">
      A cloud made of <span class="text-[#00d992]">living nature</span>
    </Fragment>
    <Fragment slot="subtitle">
      Today's cloud is huge buildings full of computers. The living cloud is forests, reefs and soil — heard from a
      distance, never touched. <b>Nature does the talking. Computers check what it says. Nature gets the credit.</b>
    </Fragment>
  </Hero>

  <!-- 2 — how it works: jobs + journey + words -->
  <WidgetWrapper id="how" containerClass="max-w-6xl">
    <Headline
      tagline="How it works"
      title="Every cloud has four jobs"
      subtitle="A cloud listens, checks, thinks and remembers. Here is how the living cloud does each one — and how much works today."
      classes={{ container: 'max-w-4xl' }}
    />
    <Features2 columns={2} classes={{ container: 'pb-0 md:pb-0 lg:pb-0' }} items={jobs} />
    <div class="mx-auto mt-8 max-w-3xl">
      <Details title="Follow one signal's journey" hint="7 steps, click to expand">
        <Timeline items={journey} layout="vertical" />
      </Details>
    </div>
  </WidgetWrapper>

  <!-- 3 — live: hear it, see it, try it -->
  <WidgetWrapper id="live" isDark containerClass="max-w-6xl">
    <Headline
      tagline="Job 1 · Listen"
      title="A thirsty plant makes a sound"
      subtitle="In 2023, scientists put tiny microphones next to tomato plants. When the soil dried out, the plants clicked — about 35 times an hour. The sound is too high for human ears. Here it is, slowed down so you can hear it:"
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="mx-auto max-w-4xl">
      <PlantListen />
      <TierLink anchor="truth-plant-sound" tier="science" />
    </div>
    <div class="mt-14 grid items-center gap-10 md:grid-cols-2">
      <div>
        <Headline
          tagline="Job 1 · Listen — the ears"
          title="A $40 box that listens without touching"
          subtitle="It hears birds, insects and plant clicks, sees the weather nearby — and talks back only when nature's guardian and the box's owner both say yes. It sits near living things, never on them."
          classes={{ container: 'md:mx-0 md:text-left mb-6', title: 'text-2xl md:text-3xl' }}
        />
        <TierLink anchor="truth-listener" tier="built" />
      </div>
      <Board3D />
    </div>
    <div class="mt-14">
      <Headline
        tagline="Jobs 2 and 3 · Check and think"
        title="Try it: 15 real brain maps answer you"
        subtitle="Scientists have mapped every nerve in some tiny animals, like a worm and a fruit fly. Think of it as a subway map of a brain. Press the button: our computers send your signal through 15 of these maps. Each one gives its own answer, plus a receipt you can re-check."
        classes={{ container: 'max-w-4xl', title: 'text-2xl md:text-3xl' }}
      />
      <Globe />
      <p class="text-muted mt-4 text-center font-mono text-xs">
        Today a regular computer runs the maps. No animal is involved.
      </p>
      <div class="mt-2 text-center"><TierLink anchor="truth-network" tier="live" /></div>
    </div>

    <!-- the federation: allied networks' devices, honestly labeled -->
    <div class="mt-16">
      <Headline
        tagline="Job 1 · Listen — the shared ears"
        title="Already listening — nature's other ears"
        subtitle="Our boxes are not the only ones. Bird trackers, river gauges, sea floats and whole observatories are already out there. We can carry their notes — each one labeled with whose device heard it."
        classes={{ container: 'max-w-4xl', title: 'text-2xl md:text-3xl' }}
      />
      <div class="mx-auto max-w-4xl">
        <Details title="The catalogue — every allied network" hint="reads, writes, status">
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-xl border border-white/10 bg-black/30 p-5">
              <h3 class="text-heading mb-3 font-mono text-xs uppercase tracking-wide">
                They listen — we carry their notes
              </h3>
              <ul class="space-y-2 text-sm">
                {
                  federation.reads.map((r) => (
                    <li class="flex items-start justify-between gap-3">
                      <span>
                        <b class="text-heading">{r.name}</b>
                        <span class="text-muted"> — {r.hears}</span>
                        <span class="text-muted block text-xs">{r.devices}</span>
                      </span>
                      <span
                        class:list={[
                          'mt-0.5 shrink-0 rounded border px-1.5 py-0.5 font-mono text-[10px] uppercase',
                          r.status === 'live' && 'border-[#00d992]/40 text-[#00d992]',
                          r.status === 'verify' && 'border-cyan-400/40 text-cyan-300',
                          r.status === 'partner' && 'border-violet-400/40 text-violet-300',
                        ]}
                      >
                        {r.statusLabel}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="rounded-xl border border-white/10 bg-black/30 p-5">
              <h3 class="text-heading mb-3 font-mono text-xs uppercase tracking-wide">
                They can act — only when the owner says yes
              </h3>
              <ul class="space-y-2 text-sm">
                {
                  federation.writes.map((w) => (
                    <li class="flex items-start justify-between gap-3">
                      <span>
                        <b class="text-heading">{w.name}</b>
                        <span class="text-muted"> — {w.kind}</span>
                      </span>
                      <span
                        class:list={[
                          'mt-0.5 shrink-0 rounded border px-1.5 py-0.5 font-mono text-[10px] uppercase',
                          w.status === 'open-invitation' && 'border-[#00d992]/40 text-[#00d992]',
