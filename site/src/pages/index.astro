---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Layout from '~/layouts/PageLayout.astro';

import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import PlantListen from '~/components/living/PlantListen.astro';
import AnswerPlant from '~/components/living/AnswerPlant.astro';
import Board3D from '~/components/living/Board3D.astro';
import Globe from '~/components/living/Globe.astro';
import WebNode from '~/components/living/WebNode.astro';
import FedLive from '~/components/living/FedLive.astro';
import LivePulse from '~/components/living/LivePulse.astro';
import Details from '~/components/living/Details.astro';
import ValueLoop from '~/components/living/ValueLoop.astro';
import OrganismMap from '~/components/living/OrganismMap.astro';
import LaneTable from '~/components/living/LaneTable.astro';
import JoinForm from '~/components/living/JoinForm.astro';
import TierLink from '~/components/living/TierLink.astro';
import WayIn from '~/components/living/WayIn.astro';
import StoryScroll from '~/components/living/StoryScroll.astro';
import ProgressMeter from '~/components/living/ProgressMeter.astro';
import HeroScene from '~/components/art/HeroScene.astro';
import GreyVsGreen from '~/components/art/GreyVsGreen.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import cloud from '~/data/cloud.json';
import market from '~/data/market.json';
import federation from '~/data/federation.json';
import tiers from '~/data/tiers.json';
import { honesty } from '~/data/honesty';
import { tierChip, type TierKey } from '~/utils/tiers';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'What if nature was the cloud? — the living cloud',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const chips = (keys: TierKey[]) => keys.map(tierChip).join(' ');

const concepts = [
  {
    title: 'The living cloud',
    icon: 'tabler:cloud',
    description:
      'A cloud is a network that listens, checks, thinks and remembers. Ours uses nature and small boxes instead of giant buildings.',
  },
  {
    title: 'The AI organism',
    icon: 'tabler:atom-2',
    description: `All the AI companions, boxes, receipts and brain maps working together like one living thing. It grows by using less.<br/>${chips(['vision'])}`,
  },
  {
    title: 'AI companion',
    icon: 'tabler:robot',
    description: `Each forest, reef or field gets its own helper that keeps its records, follows its guardian's choices and speaks up for it. Today it is a simple rule-following program.<br/>${chips(['built'])}`,
  },
  {
    title: 'Listener',
    icon: 'tabler:ear',
    description: `Like a weather station with ears. About $40, runs on a battery or the sun, never touches anything.<br/>${chips(['built'])}`,
  },
  {
    title: 'Signal',
    icon: 'tabler:wave-sine',
    description: `Anything nature gives off that we can sense from far away: a click, a bird song, a change in the water.<br/>${chips(['science'])}`,
  },
  {
    title: 'Quorum',
    icon: 'tabler:users-group',
    description: `Like a video review in sports: one camera angle isn't enough, several have to agree.<br/>${chips(['built'])}`,
  },
  {
    title: 'Receipt',
    icon: 'tabler:receipt',
    description: `Like a sealed envelope with a fingerprint. Open it, redo the work, and the fingerprint must match.<br/>${chips(['live'])}`,
  },
  {
    title: 'Connectome',
    icon: 'tabler:route',
    description: `A map of every nerve in a small animal's brain, like a subway map. We run these maps on computers.<br/>${chips(['live'])}`,
  },
  {
    title: 'Guardian',
    icon: 'tabler:user-shield',
    description: `A person who looks after a plant, animal group or place, like a coach or a parent. They hold its credit and its choices.<br/>${chips(['built'])}`,
  },
  {
    title: 'Voice 0',
    icon: 'tabler:hand-stop',
    description: `Nature always speaks first and can say no. If it says no, nothing happens, and the 'no' is written down.<br/>${chips(['built'])}`,
  },
  {
    title: 'Credit',
    icon: 'tabler:coin',
    description: `Points nature earns for what it shares, kept like a savings account.<br/>${chips(['built'])}`,
  },
  {
    title: 'Realm',
    icon: 'tabler:map-pin-heart',
    description: `Guardians of Earth's word for a place with its own caretakers and score. A partner network we are building alongside.<br/>${chips(['federated'])}`,
  },
  {
    title: 'Web node',
    icon: 'tabler:device-mobile',
    description: `Your own phone or laptop as a listener. The browser asks first, checking happens on the device, and you can take it back any time.<br/>${chips(['federated'])}`,
  },
  {
    title: 'Market report',
    icon: 'tabler:chart-line',
    description: `A guess at how much people spend on something, made by market researchers. Useful direction — not a measurement.<br/>${chips(['market'])}`,
  },
];

type Row = { claim: string; note: string; bad?: boolean };
const measured: Row[] = [
  {
    claim: 'Packed int4 CSR wiring is <b>46×–5,900× smaller</b> than fp32 dense weights',
    note: 'measured bytes · celegans → medulla · <a class="underline" href="https://github.com/treetable/living-resources/blob/main/docs/EFFICIENCY.md">EFFICIENCY.md</a>',
  },
  {
    claim: 'At ≥10⁴ neurons, connectome legs use <b>~70× fewer joules</b> than dense fp32 on the same silicon',
    note: 'measured RAPL · medulla 0.117 J vs 8.30 J · 3.3 ms vs 104 ms',
  },
  {
    claim: 'Deterministic traces replay <b>bit-for-bit</b> — TS port identical to the Python engine',
    note: '930/930 checks · workers/compute-api/test/diff.mjs',
  },
  {
    claim: 'At 302 neurons the interpreter is <b>~20× slower</b> than SIMD — reported, not hidden',
    note: 'measured — unfavorable cells are part of the evidence',
    bad: true,
  },
  {
    claim: 'Shuffled wiring with identical degree statistics performs <b>identically</b>',
    note: 'measured control — the win is sparsity; biology contributes the signature, not the speed',
    bad: true,
  },
];

const field: Row[] = [
  {
    claim: 'Stressed plants emit <b>remotely detectable, informative ultrasound</b> — tomato ~35 clicks/h, 20–100 kHz',
    note: '<a class="underline" href="https://doi.org/10.1016/j.cell.2023.03.009">Khait et al., Cell 2023</a> — one replication attempt (Göttingen 2025, doi:10.25625/13agyl) found no peaks; we cite the original and welcome adversarial checks',
  },
  {
    claim: 'Biofilms broadcast <b>K⁺ electrical waves</b> that attract distant cells across species',
    note: '<a class="underline" href="https://doi.org/10.1038/nature15709">Prindle et al., Nature 2015</a> · <a class="underline" href="https://doi.org/10.1016/j.cell.2016.12.012">Humphries et al., Cell 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.aah4204">Liu et al., Science 2017</a>',
  },
  {
    claim: 'Reef acoustic complexity <b>tracks biodiversity and recovery</b>',
    note: '<a class="underline" href="https://doi.org/10.1111/1365-2664.14274">J Appl Ecol 2022</a>',
  },
  {
    claim: 'DNA archival storage reaches <b>215 petabytes per gram</b>',
    note: '<a class="underline" href="https://doi.org/10.1126/science.aaj2038">Erlich &amp; Zielinski, Science 2017</a> · <a class="underline" href="https://doi.org/10.1126/science.1226355">Church et al., Science 2012</a> — field evidence for biological density, <b>not our lane</b>',
  },
  {
    claim: 'Neuromorphic silicon runs at <b>~24–26 pJ per synaptic event</b>; a biological synapse ~1–100 pJ',
    note: '<a class="underline" href="https://doi.org/10.1126/science.1254642">Merolla et al., Science 2014</a> · <a class="underline" href="https://doi.org/10.1109/MM.2018.112130359">Davies et al., IEEE Micro 2018</a> — cited, unverified by us',
  },
  {
    claim:
      'A brain does an estimated <b>10¹³–10¹⁶ ops/s on ~20 W</b> — ~10×–10,000× more per watt than El Capitan (1.8 EFLOP/s @ 29.7 MW)',
    note: '<a class="underline" href="https://arxiv.org/abs/1602.04019">Sandberg 2016</a> · <a class="underline" href="https://doi.org/10.1073/pnas.2107022118">Levy & Calvert, PNAS 2021</a> · <a class="underline" href="https://www.top500.org/system/180307/">TOP500</a> — cited; synaptic events are not FLOPs',
  },
  {
    claim: 'Commercial wetware already reads and writes living neurons in <b>sub-millisecond cycles</b>',
    note: 'Cortical Labs CL1, 800k neurons, shipping 2025 — <a class="underline" href="https://www.abc.net.au/news/science/2025-03-05/cortical-labs-neuron-brain-chip/104996484">ABC</a> · <a class="underline" href="https://www.forbes.com/sites/johnkoetsier/2025/06/04/hardware-software-meet-wetware-a-computer-with-800000-human-neurons/">Forbes</a> — vendor-reported, unverified by us; lab-grown cells, not our substrate',
  },
  {
    claim: 'DNA data retrieval got <b>3,200× faster</b> with 40% higher accuracy',
    note: '<a class="underline" href="https://doi.org/10.1038/s42256-025-01003-z">Bar-Lev et al., Nature Machine Intelligence 2025</a> — in-vitro pipeline; the non-invasive in-vivo interface remains unknown',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- ======================= HERO ======================= -->
  <section id="top" class="relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pt-24 pb-10 sm:px-6 md:pt-32 lg:grid-cols-2">
      <div class="text-center lg:text-left">
        <span
          class="text-leaf inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1.5 text-xs font-bold uppercase tracking-widest"
        >
          <span class="lc-live-dot" aria-hidden="true"></span> the living cloud
        </span>
        <h1
          class="font-heading text-heading mt-5 mb-5 text-5xl leading-tight font-bold tracking-tight text-balance md:text-6xl"
        >
          What if <span class="text-leaf">nature</span> was the cloud?
        </h1>
        <p class="text-muted mx-auto max-w-xl text-xl leading-relaxed lg:mx-0">
          Today's internet lives in giant buildings full of machines that wear out. The living cloud is forests, reefs
          and soil — listening, thinking, remembering. <b class="text-heading"
            >Nature does the talking — and, piece by piece, the computing.</b
          >
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
          <a href="#try" class="btn-primary">Try it now</a>
          <a href="#join" class="btn">Find your way in</a>
        </div>
        <LivePulse />
      </div>
      <HeroScene />
    </div>
    <WayIn compact />
  </section>

  <!-- ======================= grey vs green ======================= -->
  <WidgetWrapper id="green" isDark containerClass="max-w-6xl">
    <Headline
      tagline="The idea in one picture"
      title="Machines wear out. Nature grows back."
      subtitle="Grey solutions get worse with age — hotter, hungrier, rustier. Green ones get better. So why is the internet made of grey?"
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="mx-auto max-w-5xl">
      <GreyVsGreen />
    </div>
    <div class="mx-auto mt-8 grid max-w-5xl gap-4 sm:grid-cols-3">
      {
        cloud.stats.map((s) => (
          <div class="card p-5 text-center">
            <div class="font-heading text-2xl font-bold text-leaf">{s.value}</div>
            <div class="text-default mt-1 text-sm">{s.label}</div>
            <div class="text-muted mt-1 font-mono text-xs" data-reading="skip">
              {s.note}
            </div>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- ======================= how it works: the story ======================= -->
  <WidgetWrapper id="how" containerClass="max-w-6xl">
    <Headline
      tagline="How it works"
      title="One click, five stops"
      subtitle="Follow a single signal — from a thirsty tomato plant all the way to a receipt that pays the forest back."
      classes={{ container: 'max-w-4xl' }}
    />
    <StoryScroll />
    <div class="mt-6 text-center"><TierLink anchor="truth-jobs" tier="built" /></div>
  </WidgetWrapper>

  <!-- ======================= try it ======================= -->
  <WidgetWrapper id="try" isDark containerClass="max-w-6xl">
    <span id="live"></span>
    <Headline
      tagline="The playground"
      title="Don't just read it — try it"
      subtitle="Everything in this section is real: real recordings, a real API, your real microphone — if you let it."
      classes={{ container: 'max-w-4xl' }}
    />

    <div class="grid items-start gap-8 lg:grid-cols-2">
      <!-- hear + answer a plant -->
      <div class="card p-6">
        <h3 class="font-heading text-heading text-xl font-bold">Hear a thirsty plant</h3>
        <p class="text-muted mt-1 mb-4 text-sm">
          In 2023, scientists put tiny microphones next to tomato plants. When the soil dried out, the plants clicked —
          about 35 times an hour. Here it is, slowed down so you can hear it:
        </p>
        <PlantListen />
        <div class="mt-2"><TierLink anchor="truth-plant-sound" tier="science" /></div>
      </div>
      <AnswerPlant />
    </div>

    <!-- brain maps -->
    <div class="mt-14">
      <Headline
        tagline="Check and think"
        title="Send a signal through 15 real brain maps"
        subtitle="Scientists have mapped every nerve in some tiny animals — a worm, a fruit fly. Press the button: our computers send your signal through 15 of these maps. Each one answers, plus a receipt you can re-check."
        classes={{ container: 'max-w-4xl', title: 'text-2xl md:text-3xl' }}
      />
      <Globe />
      <p class="text-muted mt-4 text-center font-mono text-xs">
        today an ordinary computer runs the maps — no animal is involved
      </p>
      <div class="mt-2 text-center"><TierLink anchor="truth-network" tier="live" /></div>
    </div>

    <!-- your device + the box -->
    <div class="mt-14 grid items-center gap-10 lg:grid-cols-2">
      <WebNode
        reads={federation.yourDevice.reads}
        writes={federation.yourDevice.writes}
        rule={federation.yourDevice.rule}
      />
      <div>
        <Headline
          tagline="Meet the box"
          title="A $40 listener that never touches anything"
          subtitle="It hears birds, insects and plant clicks, notices the weather — and talks back only when nature's guardian and the box's owner both say yes. Runs on a battery or the sun."
          classes={{ container: 'md:mx-0 md:text-left mb-6', title: 'text-2xl md:text-3xl' }}
        />
        <Board3D />
        <div class="mt-2"><TierLink anchor="truth-listener" tier="built" /></div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- ======================= already listening ======================= -->
  <WidgetWrapper id="network" containerClass="max-w-6xl">
    <Headline
      tagline="The wider forest"
      title="You're not the first ears out here"
      subtitle="Bird trackers, river gauges, sea floats and whole observatories are already listening. The living cloud carries their notes — each one labeled with whose device heard it."
      classes={{ container: 'max-w-4xl' }}
    />
    <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-3">
      <div class="card p-5 text-center">
        <div class="font-heading text-2xl font-bold text-lc-sky">~100,000</div>
        <div class="text-default mt-1 text-sm">devices already listening for nature</div>
        <div class="text-muted mt-1 font-mono text-xs" data-reading="skip">partner networks' own counts</div>
      </div>
      <div class="card p-5 text-center">
        <div class="font-heading text-2xl font-bold text-lc-sky">~2 million</div>
        <div class="text-default mt-1 text-sm">people already observing with iNaturalist</div>
      </div>
      <div class="card p-5 text-center">
        <div class="font-heading text-2xl font-bold text-lc-sky">yours</div>
        <div class="text-default mt-1 text-sm">every phone and laptop can join — if you say yes</div>
      </div>
    </div>
    <div class="mx-auto mt-8 max-w-3xl">
      <FedLive />
    </div>
    <div class="mx-auto mt-6 max-w-4xl">
      <Details title="The catalogue — every allied network" hint="reads, writes, status">
        <div class="grid gap-6 md:grid-cols-2">
          <div class="card p-5">
            <h3 class="text-heading mb-3 font-mono text-xs uppercase tracking-wide">
              They listen — we carry their notes
            </h3>
            <ul class="space-y-2 text-sm">
              {
                federation.reads.map((r) => (
                  <li class="flex items-start justify-between gap-3">
                    <span>
                      <b class="text-heading">{r.name}</b>
                      <span class="text-muted"> — {r.hears}</span>
                      <span class="text-muted block text-xs">{r.devices}</span>
                    </span>
                    <span
                      class:list={[
                        'mt-0.5 shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase',
                        r.status === 'live' && 'border-leaf/50 text-leaf',
                        r.status === 'verify' && 'border-lc-sky/50 text-lc-sky',
                        r.status === 'partner' && 'border-[#7c4dc9]/50 text-[#7c4dc9] dark:text-[#b48ef0]',
                      ]}
                    >
                      {r.statusLabel}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="card p-5">
            <h3 class="text-heading mb-3 font-mono text-xs uppercase tracking-wide">
              They can act — only when the owner says yes
            </h3>
            <ul class="space-y-2 text-sm">
              {
                federation.writes.map((w) => (
                  <li class="flex items-start justify-between gap-3">
                    <span>
                      <b class="text-heading">{w.name}</b>
                      <span class="text-muted"> — {w.kind}</span>
                    </span>
                    <span
                      class:list={[
                        'mt-0.5 shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase',
                        w.status === 'open-invitation' && 'border-leaf/50 text-leaf',
                        w.status === 'opt-in' &&
                          'border-[#c98a1e]/50 text-[#9a6516] dark:border-[#ffd166]/50 dark:text-[#ffd166]',
                        w.status === 'partner' && 'border-[#7c4dc9]/50 text-[#7c4dc9] dark:text-[#b48ef0]',
                        w.status === 'human' && 'border-lc-sky/50 text-lc-sky',
                      ]}
                    >
                      {w.statusLabel}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="text-muted mt-3 text-xs">
              Every write needs two yeses: the device owner's key and the place's guardian. Each device answers only for
              what it declared — a watering box waters; it cannot be asked to play sound. Every ask and act leaves a
              receipt.
            </p>
          </div>
        </div>
        <p class="text-muted mt-4 font-mono text-xs">
          {federation.backhaul.map((b) => `${b.name}: ${b.does}`).join(' ')}
        </p>
      </Details>
    </div>
    <div class="mt-4 text-center"><TierLink anchor="truth-federation" tier="federated" /></div>
  </WidgetWrapper>

  <!-- ======================= why it matters ======================= -->
  <WidgetWrapper id="why" isDark containerClass="max-w-6xl">
    <Headline
      tagline="Why it matters"
      title="Nature is already worth more alive"
      subtitle="A living forest already beats a felled one — air, water, soil. But the world rarely pays for it. If ecosystems also join our search for knowledge — sensing, compute, storage — the partnership deepens."
      classes={{ container: 'max-w-4xl' }}
    />
    <ValueLoop />
    <div class="mx-auto mt-10 grid max-w-5xl gap-4 md:grid-cols-3">
      <div class="card p-6">
        <h3 class="font-heading text-heading text-lg font-bold">Early warning, cheaper water</h3>
        <p class="text-muted mt-2 text-sm">
          A thirsty field clicks before it wilts. Sick crops and stressed reefs show up in sound days before anyone can
          see them.
        </p>
      </div>
      <div class="card p-6">
        <h3 class="font-heading text-heading text-lg font-bold">Proof that pays</h3>
        <p class="text-muted mt-2 text-sm">
          Every claim comes with a receipt anyone can re-check. Nature earns credit for what it gives — a forest starts
          to pay for its own protection.
        </p>
      </div>
      <div class="card p-6">
        <h3 class="font-heading text-heading text-lg font-bold">Nature can say no</h3>
        <p class="text-muted mt-2 text-sm">
          Listening, paying back, letting it refuse. If a living system should not be read, it stays unread — even the
          'no' is written down.
        </p>
      </div>
    </div>
    <div class="mt-6 text-center"><TierLink anchor="truth-loop" tier="vision" /></div>

    <!-- market strip -->
    <div class="mt-14">
      <Headline
        tagline="The market that's forming"
        title="Not just proof — sensing, compute and storage by nature"
        subtitle="Checking nature claims is a market that is stuck — buyers pay for data they can't verify. But the living cloud is not just proof: it is sensing, compute and storage done by nature itself."
        classes={{ container: 'max-w-4xl', title: 'text-2xl md:text-3xl' }}
      />
      <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          market.stats.map((s) => (
            <div class="card p-5 text-center">
              <div class="font-heading text-2xl font-bold text-clay">{s.value}</div>
              <div class="text-default mt-1 text-sm">{s.label}</div>
              <div class="mt-2">
                <Fragment set:html={tierChip('market')} />
              </div>
              <div class="text-muted mt-1 font-mono text-xs" data-reading="skip">
                {s.note}
              </div>
            </div>
          ))
        }
      </div>
      <div class="mx-auto mt-8 max-w-3xl">
        <Details title="How big is this, really?" hint="the market funnel, in order">
          <div class="flex flex-col items-center gap-3">
            {
              market.funnel.map((f) => (
                <div class={`${f.width} card p-5 text-center`}>
                  <div class="text-muted font-mono text-xs uppercase tracking-wide">{f.tier}</div>
                  <div class="text-heading font-semibold">{f.plain}</div>
                  <div class="font-heading mt-1 text-xl font-bold text-leaf">{f.value}</div>
                  <p class="text-muted mt-1 text-sm">{f.desc}</p>
                  <div class="text-muted mt-1 font-mono text-xs" data-reading="skip">
                    {f.note}
                  </div>
                </div>
              ))
            }
          </div>
        </Details>
      </div>
      <p class="text-muted mx-auto mt-4 max-w-3xl border-l-2 border-clay/40 pl-4 text-sm italic">
        We're not claiming this revenue yet — these are the market's own numbers, and the receipts are ours.
      </p>
      <div class="mt-4 text-center"><TierLink anchor="truth-market" tier="market" /></div>
    </div>
  </WidgetWrapper>

  <!-- ======================= where it's going ======================= -->
  <WidgetWrapper id="future" containerClass="max-w-6xl">
    <span id="organism"></span><span id="cloud"></span>
    <Headline
      tagline="Where it's going"
      title="One organism that grows with nature"
      subtitle="Every forest, reef or field gets an AI helper. Together they form one organism — and green beats grey the only way that lasts: each new generation must prove, with receipts, that it uses less than the last."
      classes={{ container: 'max-w-4xl' }}
