---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Console from '~/components/living/Console.astro';
import LaneTable from '~/components/living/LaneTable.astro';
import { honesty } from '~/data/honesty';

const metadata = { title: 'Developers — the live API' };
const curl = `curl -X POST https://templeearth.cc/task -H 'content-type: application/json' -d '{"connectome":"celegans","features":{"confidence":0.72,"event_rate":0.35,"env_anomaly":0.18,"fleet_agreement":0.81}}'`;
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-4xl pt-8">
    <p class="text-muted mb-6 rounded-lg border border-line bg-surface p-4 text-sm" data-reading="plain">
      This page is for programmers. The living cloud's checking service is live: send it a signal, get an answer and a
      receipt, then re-check the receipt yourself.
    </p>
    <Headline
      tagline="For builders"
      title="The API is live — receipts anyone can replay"
      subtitle="Deterministic tasks over 15 EM-derived connectome wirings. Simulation over preserved wiring, witnessed — no organism computed your answer."
    />
    <div
      class="mb-8 flex flex-wrap items-center gap-3 rounded-lg border border-line bg-surface-2 p-4 font-mono text-xs"
    >
      <span class="text-leaf">$</span>
      <code class="text-default break-all">{curl}</code>
      <button id="copy" class="rounded border border-line px-2 py-0.5 text-muted hover:border-line">copy</button>
    </div>
    <Console />
  </WidgetWrapper>

  <LaneTable id="lanes" mode="tech" />

  <WidgetWrapper containerClass="max-w-4xl">
    <Headline title="Endpoints" tagline="JSON in, receipts out" classes={{ title: 'text-2xl md:text-3xl' }} />
    <div class="space-y-1 font-mono text-sm">
      {
        [
          ['GET', '/info', 'service description'],
          ['GET', '/connectomes', '15 wired substrates'],
          ['POST', '/task', '{connectome, features|input} → receipt'],
          ['POST', '/verdict', '{connectome, features} → verdict — one substrate per call'],
          ['POST', '/verify', 'receipt → {verified}'],
          ['GET', '/receipts', 'issued task_said ledger'],
          ['GET', '/receipts/{said}', 'stored receipt, replayable forever'],
          ['GET', '/federation', 'partner-network catalogue + live detections'],
          ['POST', '/presence', 'ephemeral listener ping — hashed, ~90s, nothing stored'],
          ['POST', '/join', 'waitlist — {email, role, place?, consent}'],
        ].map(([m, pth, d]) => (
          <div class="grid grid-cols-[3.5rem_11rem_1fr] items-baseline gap-3 border-b border-line py-2">
            <span class={m === 'POST' ? 'font-bold text-leaf' : 'text-muted'}>{m}</span>
            <span class="text-heading">{pth}</span>
            <span class="text-muted">{d}</span>
          </div>
        ))
      }
    </div>
    <div class="text-muted mt-8 space-y-2 font-mono text-xs">
      <p>
        // machinery: agents.scm custody → attest.scm quorum → settlement.scm credit → offers.scm gate · component map → <a
          class="text-leaf underline"
          href="https://github.com/TerexitariusStomp/living-resources/blob/master/docs/ARCHITECTURE.md"
          >docs/ARCHITECTURE.md</a
        >
      </p>
      <p>
        // seams: mic · camera · sonar · c4d · weather adapters → reticulum uplink → classify.py edge ML
        (OpenSoundscape) → e0/score.py blinded validation · specs.scm vocabulary · sense-subject.scm ^sense-node ·
        adapters/connectome.scm verdict leg · blake2s.ts vendored hashing
      </p>
      <p>
        // lanes graduate experiment → offer only when their evidence fingerprint lands. receipts are the product; the
        rest is a research program with the brakes on.
      </p>
    </div>
  </WidgetWrapper>

  <WidgetWrapper id="claims" containerClass="max-w-4xl">
    <Headline
      title="The claim ledger"
      tagline="every headline, footnoted"
      subtitle="The landing page shows one plain line per claim. This is the same ledger with the technical notes — what is measured, what is cited, what is refused."
      classes={{ title: 'text-2xl md:text-3xl' }}
    />
    <div class="space-y-4">
      {
        honesty.map((s) => (
          <div id={`dev-${s.id}`} class="card scroll-mt-24 p-5">
            <p class="text-heading text-sm font-semibold">{s.title}</p>
            <p class="text-default mt-1 text-sm">{s.plain}</p>
            <p class="text-muted mt-2 text-xs leading-relaxed" set:html={s.body} />
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-6 font-mono text-xs">
      // landing-page label chips resolve to the same ids — one ledger, two reading levels
    </p>
  </WidgetWrapper>
</Layout>

<script>
  (document.getElementById('copy') as HTMLButtonElement).onclick = (e) => {
    const btn = e.target as HTMLElement;
    navigator.clipboard.writeText(
      'curl -X POST https://templeearth.cc/task -H \'content-type: application/json\' -d \'{"connectome":"celegans","features":{"confidence":0.72,"event_rate":0.35,"env_anomaly":0.18,"fleet_agreement":0.81}}\''
    );
    btn.textContent = 'copied';
    setTimeout(() => (btn.textContent = 'copy'), 1500);
  };
</script>
